<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata. A Flatpak with no metainfo installs but shows up in
  COSMIC Store and GNOME Software as a nameless entry, and Flathub rejects
  it outright, so it ships with the desktop entry rather than after it.

  The licence spelling is settled: AGPL-3.0-only (owner, 2026-07-31). The
  repository says "AGPL-3.0" and carries no per-file "or any later version"
  grant, and the SPDX identifier for that is the -only one.

  The id is the application ID issue #66 settled and issue #75 put in the
  code, so it is also this file's name, the binary's `APP_ID`, the icon
  basenames and the cosmic-config directories (docs/DISTRIBUTION.md 3.6).
-->
<component type="desktop-application">
  <id>dev.harding.Kjerag</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <name>Kjerag</name>
  <summary>360 video player</summary>

  <!--
    The summary and the first paragraph below are also the .flatpakref's
    Comment and Description (scripts/pages-site.sh reads them out of here), so
    they are what a software centre shows before the remote is trusted, when
    this file is not reachable yet.

    The camera list mirrors the README's support table, which is the truth of
    it; the two drifting apart is a defect. Naming the cameras Kjerag does not
    play is the other half of naming them in the keywords: somebody arriving
    from a search for their GoPro reads what it does today in the same breath.
  -->
  <description>
    <p>
      Kjerag plays Insta360 .insv files directly: open the file straight off
      the camera and press play. Zero configuration.
    </p>
    <ul>
      <li>Drag to reframe, scroll to zoom</li>
      <li>Gyro horizon lock</li>
      <li>Blended lens seam</li>
      <li>Screenshots</li>
      <li>Copyable view references</li>
      <li>Zero-copy hardware decode</li>
    </ul>
    <p>Camera support:</p>
    <ul>
      <li>Insta360 X4 Air and ONE X2: fully supported</li>
      <li>Insta360 X3, X4 and X5: unverified</li>
      <li>GoPro and DJI: not supported, refused by name</li>
    </ul>
    <p>
      Requests and sample footage for more cameras are welcome on the issue
      tracker.
    </p>
    <p>
      The dual fisheye footage is decoded on the GPU and reprojected through
      the calibrated lens model that every .insv carries, so the horizon is
      where it belongs and the seam between the two lenses is blended.
    </p>
  </description>

  <launchable type="desktop-id">dev.harding.Kjerag.desktop</launchable>

  <provides>
    <mediatype>video/x-insta360-insv</mediatype>
  </provides>

  <url type="homepage">https://github.com/aeharding/kjerag</url>
  <url type="bugtracker">https://github.com/aeharding/kjerag/issues</url>
  <url type="vcs-browser">https://github.com/aeharding/kjerag</url>

  <developer id="dev.harding">
    <name>Alex Harding</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <categories>
    <category>AudioVideo</category>
    <category>Player</category>
    <category>Video</category>
  </categories>

  <!--
    Cameras Kjerag does not play are in here on purpose (owner, 2026-08-01):
    somebody with a GoPro Max or an Osmo 360 should find this app, meet the
    refusal that names their format, and send a clip toward support. The
    description above is what keeps that from being a bait: it says which
    cameras work today.

    The same set is the desktop entry's Keywords, which is what the launcher
    searches.
  -->
  <keywords>
    <keyword>360</keyword>
    <keyword>360 video</keyword>
    <keyword>360 camera</keyword>
    <keyword>insta360</keyword>
    <keyword>insta 360</keyword>
    <keyword>insv</keyword>
    <keyword>fisheye</keyword>
    <keyword>reframe</keyword>
    <keyword>panorama</keyword>
    <keyword>spherical</keyword>
    <keyword>gopro</keyword>
    <keyword>gopro max</keyword>
    <keyword>max</keyword>
    <keyword>max 360</keyword>
    <keyword>dji</keyword>
    <keyword>osmo</keyword>
    <keyword>osmo 360</keyword>
    <keyword>player</keyword>
  </keywords>

  <!--
    Real windows over real footage, taken and approved for publication by
    the owner (2026-08-01). The images live in this repository so the URLs
    below resolve once this lands on main.
  -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/aeharding/kjerag/main/resources/screenshots/reframe.png</image>
      <caption>Watching a flight, reframed by dragging</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/aeharding/kjerag/main/resources/screenshots/planet.png</image>
      <caption>Zoomed all the way out to a little planet</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.2" type="development" date="2026-08-02"/>
    <release version="0.1.1" type="development" date="2026-08-01"/>
    <release version="0.1.0" type="development" date="2026-07-31">
      <description>
        <p>Beta. Playback, reframing and stills work.</p>
      </description>
    </release>
  </releases>
</component>
